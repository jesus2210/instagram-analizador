# Crea una app en Meta for Developers con Instagram API with Facebook Login.
META_APP_ID=
META_APP_SECRET=
# Opcional: configuración de Facebook Login for Business con token de usuario.
META_LOGIN_CONFIG_ID=
# Origen público del servidor; callback exacto: APP_URL/api/instagram/callback
# En desarrollo local puedes usar http://localhost:5173 si Meta lo admite.
APP_URL=
PORT=3001

# En Vercel: crea/conecta Redis (Upstash) para sesiones compartidas.
# También se admiten KV_REST_API_URL y KV_REST_API_TOKEN del Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: estudio creativo con IA (solo servidor; nunca prefijo VITE_).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Seguimiento diario: secreto aleatorio privado, configurado también en Vercel.
CRON_SECRET=
