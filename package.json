{
  "name": "pulso-content-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.js",
